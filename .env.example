# ==============================================================================
# ENVIRONMENT VARIABLES: EVENTKU PLATFORM
# ==============================================================================

# Supabase Credentials (Database, Auth & Storage)
# Dapat diambil dari Project Settings > API di dashboard Supabase Anda:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Payment Gateway Configuration (Official Integration)
# Pilihan 1: Midtrans Snap (Indonesia)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Pilihan 2: Xendit Invoice (Opsional)
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxx

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

